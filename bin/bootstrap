#!/usr/bin/env bash
# ══════════════════════════════════════════════════════════════════════════════
# ZomboCraftEco Bootstrap — full ecosystem setup in one command
#
# Usage:
#   ./bin/bootstrap           # full setup
#   ./bin/bootstrap --minimal # gm + repos only (skip flowspec/br/bv)
#
# Prerequisites: git, gh (GitHub CLI, authenticated)
# ══════════════════════════════════════════════════════════════════════════════

set -e
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
MINIMAL=false
[ "$1" = "--minimal" ] && MINIMAL=true

# ── Platform detection ──────────────────────────────────────────────────────
case "$(uname -s)" in
  MINGW*|MSYS*|CYGWIN*) IS_WINDOWS=true ;;
  *)                     IS_WINDOWS=false ;;
esac

if $IS_WINDOWS; then
  INSTALL_BIN="${LOCALAPPDATA:-$USERPROFILE/AppData/Local}/Programs/bin"
  EXE=".exe"
else
  INSTALL_BIN="$HOME/.local/bin"
  EXE=""
fi

echo "╔══════════════════════════════════════════╗"
echo "║     ZomboCraftEco Bootstrap v1.0         ║"
echo "╚══════════════════════════════════════════╝"
echo ""
echo "Root:     $ROOT"
echo "Platform: $(uname -s) $(uname -m)"
echo ""

# ── Step 1: Check prerequisites ───────────────────────────────────────────────

echo "── Step 1: Prerequisites ──"
command -v git &>/dev/null && echo "  ✓ git" || { echo "  ✗ git — install git first"; exit 1; }
command -v gh &>/dev/null && echo "  ✓ gh (GitHub CLI)" || { echo "  ✗ gh — install: https://cli.github.com"; exit 1; }
gh auth status &>/dev/null && echo "  ✓ gh authenticated" || { echo "  ✗ gh not authenticated — run: gh auth login"; exit 1; }
echo ""

# ── Step 2: Install gm ───────────────────────────────────────────────────────

echo "── Step 2: Install gm ──"
if command -v gm &>/dev/null; then
    echo "  ✓ gm already installed: $(gm --version)"
else
    INSTALLED=false

    # Try 1: Download pre-built binary from GitHub Release (private repo — needs gh)
    if $IS_WINDOWS; then
        OS="windows"
    else
        OS="$(uname -s | tr '[:upper:]' '[:lower:]')"
    fi
    ARCH="$(uname -m)"
    ASSET="gm-${OS}-${ARCH}${EXE}"

    TMPDIR=$(mktemp -d)
    mkdir -p "$INSTALL_BIN"
    if gh release download v0.1.0 --repo svaiml/gm --pattern "$ASSET" --dir "$TMPDIR" 2>/dev/null; then
        chmod +x "$TMPDIR/$ASSET" 2>/dev/null || true
        mv "$TMPDIR/$ASSET" "$INSTALL_BIN/gm${EXE}"
        export PATH="$INSTALL_BIN:$PATH"
        echo "  ✓ gm installed from release binary"
        INSTALLED=true
    fi
    rm -rf "$TMPDIR" 2>/dev/null

    # Try 2: cargo install from git
    if [ "$INSTALLED" = false ]; then
        if command -v cargo &>/dev/null; then
            echo "  → No binary for $ASSET — building from source..."
            cargo install --git https://github.com/svaiml/gm.git --branch feature/m1-bootstrap --bin gm gm-cli --quiet 2>/dev/null || \
                cargo install --git https://github.com/svaiml/gm.git --branch feature/m1-bootstrap --bin gm gm-cli
            echo "  ✓ gm installed via cargo"
            INSTALLED=true
        fi
    fi

    if [ "$INSTALLED" = false ]; then
        echo "  ✗ Could not install gm. Install cargo (https://rustup.rs) or build manually."
        exit 1
    fi
fi
echo ""

# ── Step 3: Sync repos ───────────────────────────────────────────────────────

echo "── Step 3: Sync workspace (clone all repos) ──"
gm --root "$ROOT" sync
echo ""

# ── Step 4: Install ecosystem tools ──────────────────────────────────────────

if [ "$MINIMAL" = false ]; then

    echo "── Step 4: Install flowspec ──"
    if command -v flowspec &>/dev/null; then
        echo "  ✓ flowspec $(flowspec --version 2>/dev/null | head -1)"
    else
        FLOWSPEC="$ROOT/tools/orchestrator/flowspec"
        if [ -d "$FLOWSPEC" ] && command -v uv &>/dev/null; then
            (cd "$FLOWSPEC" && uv tool install --editable . --force --quiet 2>/dev/null) && \
                echo "  ✓ flowspec installed" || echo "  ✗ flowspec failed (install uv: https://astral.sh/uv)"
        elif ! command -v uv &>/dev/null; then
            echo "  → installing uv..."
            if $IS_WINDOWS; then
                powershell -ExecutionPolicy ByPass -c "irm https://astral.sh/uv/install.ps1 | iex" 2>/dev/null
            else
                curl -LsSf https://astral.sh/uv/install.sh | sh 2>/dev/null
            fi
            export PATH="$INSTALL_BIN:$HOME/.local/bin:$PATH"
            (cd "$FLOWSPEC" && uv tool install --editable . --force --quiet 2>/dev/null) && \
                echo "  ✓ flowspec installed" || echo "  ✗ flowspec failed"
        fi
    fi
    echo ""

    echo "── Step 5: Install beads tools ──"
    for tool in beads_rust:br beads_viewer_rust:bv; do
        repo="${tool%%:*}"; bin="${tool##*:}"
        if command -v "$bin" &>/dev/null; then
            echo "  ✓ $bin already installed"
        elif command -v cargo &>/dev/null; then
            echo "  → installing $bin..."
            cargo install --git "https://github.com/Dicklesworthstone/${repo}.git" --quiet 2>/dev/null && \
                echo "  ✓ $bin installed" || echo "  ✗ $bin failed"
        fi
    done
    echo ""

    echo "── Step 6: Lock workspace state ──"
    gm --root "$ROOT" lock
    echo ""
fi

# ── Done ──────────────────────────────────────────────────────────────────────

echo "╔══════════════════════════════════════════╗"
echo "║           Bootstrap complete!            ║"
echo "╚══════════════════════════════════════════╝"
echo ""
gm --root "$ROOT" status
echo ""
echo "Next:"
echo "  cd $ROOT"
echo "  gm status           # see all repos"
echo "  gm pull             # fetch latest"
echo "  gm push --plan      # dependency-ordered push"
