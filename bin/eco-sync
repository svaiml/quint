#!/usr/bin/env python3
"""eco-sync — thin shim that delegates to gm.

Migration path:
  eco-sync status      → gm status
  eco-sync sync        → gm fetch && gm pull
  eco-sync delta       → gm lock --diff
  eco-sync lock        → gm lock
  eco-sync report X    → gm status --group X
  eco-sync tree        → gm graph
  eco-sync fix-remotes → (manual — check workspace.yaml)

If gm binary is not found, falls back to eco-sync-legacy.
"""
import os
import sys
import shutil
import subprocess

ECO_ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
GM_BIN = shutil.which("gm")

# Try finding gm in the workspace build dir
if not GM_BIN:
    local_gm = os.path.join(ECO_ROOT, "tools", "sysutils", "gm", "target", "release", "gm")
    debug_gm = os.path.join(ECO_ROOT, "tools", "sysutils", "gm", "target", "debug", "gm")
    if os.path.exists(local_gm):
        GM_BIN = local_gm
    elif os.path.exists(debug_gm):
        GM_BIN = debug_gm

CMD_MAP = {
    "status": ["status"],
    "sync": ["pull"],
    "delta": ["lock", "--diff"],
    "lock": ["lock"],
    "tree": ["graph"],
    "scan": ["status"],
}

def main():
    args = sys.argv[1:]
    if not args:
        print("Usage: eco-sync <command> [args]")
        print("Commands: status, sync, delta, lock, tree, scan, report")
        print(f"\nDelegates to: {'gm' if GM_BIN else 'eco-sync-legacy (gm not found)'}")
        sys.exit(0)

    cmd = args[0]

    if not GM_BIN:
        # Fallback to legacy
        legacy = os.path.join(os.path.dirname(__file__), "eco-sync-legacy")
        os.execv(sys.executable, [sys.executable, legacy] + args)

    if cmd == "report" and len(args) > 1:
        gm_args = ["status", "--group", args[1]]
    elif cmd in CMD_MAP:
        gm_args = CMD_MAP[cmd]
    else:
        # Pass through unknown commands
        gm_args = args

    subprocess.run([GM_BIN, "--root", ECO_ROOT] + gm_args)

if __name__ == "__main__":
    main()
